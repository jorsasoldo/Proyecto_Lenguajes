// Tiene que estar el analizador en modo pánico

TOKEN :
{
	/*
		Va de mayor prioriad a menor prioridad la escritura de los tokens
	*/
	  < AT: "@" >
      | < SELECTOR: "->" >
      | < TYPE_ASSIGN: ":" >
      | < SEPARATOR: ";" >
      | < VALUE_ASSIGN: "=" >
      | < OPEN: "{" >
      | < CLOSE: "}" >
      | < PARAM_OPEN: "(" >
      | < PARAM_CLOSE: ")" >
      | < COMMA: "," >
      | < IF: "if" >
      | < ELSE: "else" >
      | < FOR: "for" >
      | < SWITCH: "switch" >
      | < WHILE: "while" >
      | < DO: "do" >
      | < VARIABLE: "var" >
      | < FUNCTION: "func" >
      | < CONSTANT: "const" >
      | < INTEGER: "int" >
      | < FLOAT: "float" >
      | < BOOLEAN: "boolean" >
      | < CHARACTER: "char" >
      | < STRING: "string" >
      | < BOOLEAN_VALUE: "true" | "false" >
      | < NUMERIC: (["0"-"9"])+ ("." (["0"-"9"])+)? > // (["0"-"9"])+ "." (["0"-"9"])*
      | < LITERAL: "\"" > //y lo q vaya en medio "\"
      | < AND: "&" >
      | < OR: "|" >
      | < NOT: "!" >
      | < LT: "<" >
      | < GT: ">" >
      | < LE: "<=" >
      | < GE: ">=" >
      | < EQ: "==" >
      | < ID: (["a"-"z", "A"-"Z", "_"]) (["a"-"z", "A"-"Z", "0"-"9", "_"])* >
}


SKIP :
    //todo lo que coincida aqui se descarta y no genera token
{
	  " "      // espacio
	| "\t"     // tabulador
	| "\n"     // salto de linea
	| "\r"     // retorno de carro (incluidos en windows)
	| "\f"     // salto de pagina
}
