/*
    Para correr por primera vez:

    javacc Parser.jj
    javac *.java
    java Parser prueba1.txt
    java Parser prueba2.txt
 */

options
{
    STATIC = false;
}

PARSER_BEGIN(Parser)

public class Parser
{
        static String nombre_token(int tipo) throws Exception
        {
            for(java.lang.reflect.Field f : ParserConstants.class.getFields())
                if(f.getType() == int.class && f.getInt(null) == tipo)
                    return f.getName();

            return "?";
        }

        public static void main(String[] args) throws Exception
            {
                Parser parser = new Parser(new java.io.FileReader(args[0]));

                Tabla_errores errores = new Tabla_errores();

                Token t;

                System.out.printf("%-15s %-18s %s%n", "TOKEN", "LEXEMA", "POSICION");

                while((t = parser.getNextToken()).kind != ParserConstants.EOF)
                {
                    //Un token de error se registra y no continua al parser
                     if(errores.procesar(t))
                         continue;

                    System.out.printf("%-15s %-18s L%d C%d%n",nombre_token(t.kind), t.image, t.beginLine, t.beginColumn);
                }

                errores.imprimir();
            }

}

PARSER_END(Parser)


SKIP :
    //todo lo que coincida aqui se descarta y no genera token
{
    //Espacio
	  " "
	//Tabulador
	| "\t"

	//Salto de linea
	| "\n"

	//Retorno de carro (incluidos en windows)
	| "\r"

	//Salto de pagina
	| "\f"

	//Comentario
	| < "//" (~["\n", "\r"])* >

	//Comentario de bloque: /* ... */ (puede ocupar varias lineas)
    | < "/*" ( ~["*"] | ("*")+ ~["*", "/"] )* ("*")+ "/" >
}

//Tiene que estar el analizador en modo pánico
TOKEN :
{
	//Asignadores
	  < AT: "@" >
      | < SELECTOR: "->" >
      | < TYPE_ASSIGN: ":" >
      | < VALUE_ASSIGN: "=" >
}

TOKEN :
{
      //Separadores
      < SEPARATOR: ";" >
      | < COMMA: "," >
}

TOKEN :
{
      //Limitadores
      < OPEN: "{" >
      | < CLOSE: "}" >
      | < PARAM_OPEN: "(" >
      | < PARAM_CLOSE: ")" >
}

TOKEN :
{
      //Condicionales
      < IF: "if" >
      | < ELSE: "else" >
      | < SWITCH: "switch" >
      | < CASE: "case" >
      | < DEFAULT_CASE: "default" >
}

TOKEN :
{
      //Ciclantes
      < FOR: "for" >
      | < WHILE: "while" >
      | < DO: "do" >
}

TOKEN :
{
      //Tipos de datos
      < INTEGER: "int" >
      | < FLOAT: "float" >
      | < BOOLEAN: "boolean" >
      | < CHARACTER: "char" >
      | < STRING: "string" >
}

TOKEN :
{
      //Declaradores
      < VARIABLE: "var" >
      | < FUNCTION: "func" >
      | < CONSTANT: "const" >
}

TOKEN :
{
      //Valores literales
       < INT_LITERAL: (["0"-"9"])+ >
       | < FLOAT_LITERAL: (["0"-"9"])+ "." (["0"-"9"])+ >
       | < CHAR_LITERAL: "'" ( ~["'", "\\", "\n", "\r"] | "\\" ~[] ) "'" >
       | < STRING_LITERAL: "\"" ( ~["\"", "\\", "\n", "\r"] | "\\" ~[] )* "\"" >
       | < BOOLEAN_VALUE: "true" | "false" >
}

TOKEN :
{
      //Compuertas Logicas
      < AND: "&" >
      | < OR: "|" >
      | < NOT: "!" >
}

TOKEN :
{
      //Comparativas
      < LT: "<" >
      | < GT: ">" >
      | < LE: "<=" >
      | < GE: ">=" >
      | < EQ: "==" >
      | < NE: "!=" >
}

TOKEN :
{
     //Libreria tools
      < TOOLS: "tools" >

     //Funciones de operaciones
     | < ADD: "add" >
     | < SUBS: "subs" >
     | < MULT: "mult" >
     | < DIV: "div" >

     //Funciones de imprimir pantalla
     | < PRINTF: "printf" >
     | < PUTS: "puts">
}

TOKEN :
{
      //Signos de operacion
      < PLUS: "+" >
      | < MINUS: "-" >
      | < STAR: "*" >
      | < SLASH: "/" >
}

TOKEN :
{
      //Identificadores
      < ID: (["a"-"z", "A"-"Z", "_"]) (["a"-"z", "A"-"Z", "0"-"9", "_"])* >
}

TOKEN :
{
      //Errores lexicos

      //LEX-01: Caracter no reconocido (se va al modo panico)

      //LEX-02: cadena sin cerrar (termina al llegar al salto de linea)
      < ERR_STRING_UNCLOSED: "\"" ( ~["\"", "\\", "\n", "\r"] | "\\" ~["\n", "\r"] )* >

      //LEX-03: numero mal formado: "3." (sin decimales) o "3.4.5" (dos puntos)
      | < ERR_NUMBER: (["0"-"9"])+ "."| "." (["0"-"9"])+| (["0"-"9"])+ "." (["0"-"9"])+ ( "." (["0"-"9"])* )+ >

      //LEX-04: identificador que empieza con digito: 7abcd
      | < ERR_ID: (["0"-"9"])+ ( "." (["0"-"9"])+ )? ["a"-"z", "A"-"Z", "_"] (["a"-"z", "A"-"Z", "0"-"9", "_"])* >

      //LEX-05: char vacio: '' o con mas de un caracter: 'ab'
      | < ERR_CHAR_LENGTH: "'" "'"| "'" ( ~["'", "\\", "\n", "\r"] | "\\" ~[] )( ~["'", "\\", "\n", "\r"] | "\\" ~[] )+ "'" >

      //LEX-06: char sin cerrar: 'a
      | < ERR_CHAR_UNCLOSED: "'" (~["'", "\n", "\r"])* >

      //LEX-07: el rango del int (maximo 2147483647) se valida en Tabla_errores.procesar() porque un patron no puede comparar valores numericos

      //LEX-08: comentario de bloque sin cerrar (llega hasta el final del archivo)
      | < ERR_COMMENT_UNCLOSED: "/*" ( ~["*"] | ("*")+ ~["*", "/"] )* ("*")* >
}


TOKEN :
{
      //Modo panico
      < UNKNOWN: ~[] >
}

//NOTA CLASE PARA TABLA SIMBOLOS Y OTRA PARA CLASE ERRORES
//UNA CLASE TIPO SIMBOLO PARA GENERALIZAR
